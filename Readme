</div><!-- FIREBASE --><script type="module">

import { initializeApp }
from "https://www.gstatic.com/firebasejs/12.2.1/firebase-app.js";

import {
getAuth,
createUserWithEmailAndPassword,
signInWithEmailAndPassword,
signOut,
onAuthStateChanged
}
from "https://www.gstatic.com/firebasejs/12.2.1/firebase-auth.js";

import {
getFirestore,
doc,
setDoc,
getDoc,
collection,
addDoc,
query,
orderBy,
getDocs,
serverTimestamp
}
from "https://www.gstatic.com/firebasejs/12.2.1/firebase-firestore.js";


const firebaseConfig = {

apiKey:"AIzaSyA_x5ZYj7D5Dt_9Bq-NzlchpRPRd3QN21I",

authDomain:"a-t-l-data.firebaseapp.com",

projectId:"a-t-l-data",

storageBucket:"a-t-l-data.firebasestorage.app",

messagingSenderId:"519558305824",

appId:"1:519558305824:web:cf6dd75ef20ef708c24445"

};


const app=initializeApp(firebaseConfig);

const auth=getAuth(app);

const db=getFirestore(app);

let loginMode=true;


/* BASIC HELPERS */

function $(id){
return document.getElementById(id);
}

function openModal(id){
$(id).style.display="flex";
}

function closeModal(id){
$(id).style.display="none";
}


/* AUTH STATE */

onAuthStateChanged(auth,async(user)=>{

const accountButton=$("accountButton");
const accountSection=$("account");

if(user){

accountButton.textContent="My Account";

$("userEmail").textContent="Email: "+user.email;

accountSection.style.display="block";

await createUserProfile(user);

await loadTransactions(user.uid);

}else{

accountButton.textContent="Login";

accountSection.style.display="none";

}

});


/* USER PROFILE */

async function createUserProfile(user){

const userRef=doc(db,"users",user.uid);

const userSnap=await getDoc(userRef);

if(!userSnap.exists()){

await setDoc(userRef,{

uid:user.uid,

email:user.email,

walletBalance:0,

createdAt:serverTimestamp()

});

}

}


/* AUTH */

async function handleAuth(){

const email=$("email").value.trim();

const password=$("password").value;

const message=$("authMessage");

message.className="error";

if(!email||!password){

message.textContent="Please enter email and password.";

return;

}

if(password.length<6){

message.textContent="Password must be at least 6 characters.";

return;

}

try{

if(loginMode){

await signInWithEmailAndPassword(auth,email,password);

message.className="success";

message.textContent="Login successful.";

}else{

const result=
await createUserWithEmailAndPassword(
auth,email,password
);

await createUserProfile(result.user);

message.className="success";

message.textContent="Account created successfully.";

}

setTimeout(()=>{

closeModal("authModal");

$("email").value="";

$("password").value="";

},700);

}catch(error){

message.textContent=getFriendlyError(error.code);

}

}


$("authSubmit").addEventListener("click",handleAuth);


/* SWITCH LOGIN / CREATE ACCOUNT */

$("switchAuth").addEventListener("click",()=>{

loginMode=!loginMode;

$("authTitle").textContent=
loginMode?"Login":"Create Account";

$("authSubmit").textContent=
loginMode?"Login":"Create Account";

$("switchAuth").textContent=
loginMode
?"Create Account"
:"Already have an account? Login";

$("authMessage").textContent="";

});


/* FRIENDLY ERRORS */

function getFriendlyError(code){

switch(code){

case"auth/email-already-in-use":
return"This email is already registered.";

case"auth/invalid-email":
return"Please enter a valid email address.";

case"auth/weak-password":
return"Password is too weak.";

case"auth/invalid-credential":
return"Incorrect email or password.";

case"auth/user-not-found":
return"Account not found.";

default:
return"Something went wrong. Please try again.";

}

}


/* LOGOUT */

$("logoutButton").addEventListener("click",async()=>{

await signOut(auth);

alert("You have been logged out.");

window.scrollTo({
top:0,
behavior:"smooth"
});

});


/* TRANSACTIONS */

async function saveTransaction(type,details){

const user=auth.currentUser;

if(!user){

alert("Please login first.");

return false;

}

try{

await addDoc(

collection(
db,
"users",
user.uid,
"transactions"
),

{

type:type,

details:details,

createdAt:serverTimestamp()

}

);

await loadTransactions(user.uid);

return true;

}catch(error){

alert("Unable to save transaction. Please try again.");

return false;

}

}


/* LOAD TRANSACTIONS */

async function loadTransactions(uid){

const history=$("transactionHistory");

history.innerHTML="Loading...";

try{

const transactionRef=
collection(
db,
"users",
uid,
"transactions"
);

const q=query(
transactionRef,
orderBy("createdAt","desc")
);

const snapshot=await getDocs(q);

if(snapshot.empty){

history.innerHTML="No transactions yet.";

return;

}

history.innerHTML="";

snapshot.forEach(item=>{

const data=item.data();

const div=document.createElement("div");

div.className="transaction";

div.textContent=
data.type+" — "+data.details;

history.appendChild(div);

});

}catch(error){

history.innerHTML=
"Transaction history will appear here.";

}

}


/* OPEN LOGIN */

$("accountButton").addEventListener("click",()=>{

if(auth.currentUser){

$("account").scrollIntoView({
behavior:"smooth"
});

}else{

openModal("authModal");

}

});


/* ACCOUNT */

$("serviceAccountButton").addEventListener("click",()=>{

if(auth.currentUser){

$("account").scrollIntoView({
behavior:"smooth"
});

}else{

openModal("authModal");

}

});


/* DATA MODALS */

$("heroDataButton").addEventListener(
"click",
()=>openModal("dataModal")
);

$("serviceDataButton").addEventListener(
"click",
()=>openModal("dataModal")
);

$("closeData").addEventListener(
"click",
()=>closeModal("dataModal")
);

$("cancelDataButton").addEventListener(
"click",
()=>closeModal("dataModal")
);


/* DATA MAIN FORM */

$("buyDataButton").addEventListener("click",async()=>{

const network=$("network").value;

const phone=$("dataPhone").value.trim();

const plan=$("dataPlan").value;

const message=$("dataMessage");

if(!auth.currentUser){

openModal("authModal");

return;

}

if(!network||!phone||!plan){

message.className="error";

message.textContent=
"Please complete all fields.";

return;

}

await saveTransaction(
"Data order",
network+" "+plan+" for "+phone
);

message.className="success";

message.textContent=
"Order recorded. Real data delivery will be connected later.";

});


/* DATA MODAL */

$("processDataButton").addEventListener("click",async()=>{

const network=$("modalNetwork").value;

const phone=$("modalPhone").value.trim();

const plan=$("modalPlan").value;

if(!auth.currentUser){

closeModal("dataModal");

openModal("authModal");

return;

}

if(!network||!phone||!plan){

alert("Please complete all fields.");

return;

}

await saveTransaction(
"Data order",
network+" "+plan+" for "+phone
);

alert(
"Order recorded. Real data delivery will be connected later."
);

closeModal("dataModal");

});


/* AIRTIME */

$("airtimeButton").addEventListener(
"click",
()=>openModal("airtimeModal")
);

$("closeAirtime").addEventListener(
"click",
()=>closeModal("airtimeModal")
);

$("cancelAirtimeButton").addEventListener(
"click",
()=>closeModal("airtimeModal")
);


$("processAirtimeButton").addEventListener("click",async()=>{

const network=$("airtimeNetwork").value;

const phone=$("airtimePhone").value.trim();

const amount=$("airtimeAmount").value;

if(!auth.currentUser){

closeModal("airtimeModal");

openModal("authModal");

return;

}

if(!network||!phone||!amount){

alert("Please complete all fields.");

return;

}

await saveTransaction(
"Airtime order",
network+" ₦"+amount+" for "+phone
);

alert(
"Order recorded. Real airtime delivery will be connected later."
);

closeModal("airtimeModal");

});


/* PAY BILLS */

$("billsButton").addEventListener(
"click",
()=>openModal("billsModal")
);

$("closeBills").addEventListener(
"click",
()=>closeModal("billsModal")
);

$("cancelBillsButton").addEventListener(
"click",
()=>closeModal("billsModal")
);


/* BILL TYPE CHANGE */

$("billType").addEventListener("change",()=>{

const type=$("billType").value;

$("electricityFields").style.display="none";

$("educationFields").style.display="none";

$("otherBillFields").style.display="none";


if(type==="electricity"){

$("electricityFields").style.display="block";

}

else if(
type==="neco"||
type==="waec"||
type==="jamb"
){

$("educationFields").style.display="block";

}

else if(
type==="cable"||
type==="internet"
){

$("otherBillFields").style.display="block";

}

});


/* PROCESS BILL */

$("processBillButton").addEventListener("click",async()=>{

if(!auth.currentUser){

closeModal("billsModal");

openModal("authModal");

return;

}

const type=$("billType").value;

if(!type){

alert("Please select a bill.");

return;

}


let details="";


if(type==="electricity"){

const provider=$("electricityProvider").value;

const meterType=$("meterType").value;

const meter=$("meterNumber").value.trim();

const amount=$("electricityAmount").value;

if(!provider||!meterType||!meter||!amount){

alert("Please complete all electricity fields.");

return;

}

details=
provider+
" — "+
meterType+
" meter "+
meter+
" — ₦"+
amount;

}


else if(
type==="neco"||
type==="waec"||
type==="jamb"
){

const examNumber=$("examNumber").value.trim();

const amount=$("educationAmount").value;

if(!examNumber||!amount){

alert("Please enter the registration number and amount.");

return;

}

details=
type.toUpperCase()+
" — "+
examNumber+
" — ₦"+
amount;

}


else{

const customer=$("customerNumber").value.trim();

const amount=$("billAmount").value;

if(!customer||!amount){

alert("Please enter customer number and amount.");

return;

}

details=
type+
" — "+
customer+
" — ₦"+
amount;

}


await saveTransaction(
"Bill payment",
details
);

alert(
"Bill order recorded. Real bill payment will be connected later."
);

closeModal("billsModal");

});


/* ADD MONEY */

$("addMoneyButton").addEventListener("click",()=>{

alert(
"Wallet funding will be connected to Paystack after the secure payment system is completed."
);

});


/* CLOSE MODALS WHEN CLICKING OUTSIDE */

window.addEventListener("click",(event)=>{

if(event.target.classList.contains("modal")){

event.target.style.display="none";

}

});

</script></body>
